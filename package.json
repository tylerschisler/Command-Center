{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:encrypt": "node --import tsx scripts/encrypt-database.ts",
    "backup:create": "node --import tsx scripts/backup.ts create",
    "backup:validate": "node --import tsx scripts/backup.ts validate",
    "backup:restore": "node --import tsx scripts/backup.ts restore",
    "recovery:init": "node --import tsx scripts/recovery.ts init",
    "recovery:verify": "node --import tsx scripts/recovery.ts verify",
    "recovery:restore-keychain": "node --import tsx scripts/recovery.ts restore-keychain",
    "recovery:rotate": "node --import tsx scripts/recovery.ts rotate",
    "jarvis:schema-audit": "node --import tsx scripts/audit-jarvis-schemas.ts",
    "security:secrets": "node --import tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "openai": "^7.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
