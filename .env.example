# Local filesystem path only. The directory is created automatically.
DATABASE_PATH=./data/command-center.db

# Local destination for manually created encrypted backups.
BACKUP_DIRECTORY=./data/backups

# Cryptographically wrapped recovery material. This file is not a secret by itself.
# Store the separately displayed recovery credential offline or in a password manager.
RECOVERY_MATERIAL_PATH=./data/recovery.ccrecovery

# Development logging level: debug, info, warn, or error.
LOG_LEVEL=info

# Server-only OpenAI configuration. Never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
